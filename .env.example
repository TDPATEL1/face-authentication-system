# -----------------------------------------------------------------------------
# Docker (required):
#   copy .env.example .env
#   copy .env.example .env.docker
#
# `.env` is read by Docker Compose for ${POSTGRES_PASSWORD} on the
# postgres service. `.env.docker` is injected into the API container.
#
# POSTGRES_PASSWORD in `.env` must match the password in DATABASE_URL
# in `.env.docker`. DATABASE_URL host must be `postgres`.
#
# Local uvicorn without Docker: use `.env` and host `localhost`:
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/user_auth_db
#
# Replace every placeholder. Never commit `.env` or `.env.docker`.
# `docker compose config` prints resolved values; do not share that output.
# -----------------------------------------------------------------------------

POSTGRES_PASSWORD=change-me-to-a-strong-postgres-password

DATABASE_URL=postgresql://postgres:change-me-to-a-strong-postgres-password@postgres:5432/user_auth_db

SECRET_KEY=change-me-to-a-long-random-secret-key

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

FACE_TEMPLATE_ENCRYPTION_KEY=change-me-generate-a-fernet-key

DOOR_CONTROLLER=simulation

ESP32_IP=http://127.0.0.1:9000

ESP32_TIMEOUT=3.0

# Host header values FastAPI will accept (comma-separated).
# Add your LAN hostname or IP if you will not use localhost.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Browser origins allowed to call the API (comma-separated).
# /docs through Nginx is same-origin and does not need CORS.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

ESP32_SHARED_SECRET=change-me-to-a-strong-esp32-shared-secret
